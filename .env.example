# Neon pooled connection string
DATABASE_URL=

# Public URL of the app, e.g. http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
# Random string of at least 32 characters (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=

# Random string used to encrypt calendar tokens at rest. Changing it makes
# every existing calendar connection unreadable.
TOKEN_ENCRYPTION_KEY=

# Google Cloud OAuth client (Web application). Authorized redirect URIs:
#   <BETTER_AUTH_URL>/api/auth/callback/google   (sign-in)
#   <BETTER_AUTH_URL>/api/calendar/callback      (calendar connection)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# KMA API Hub key (apihub.kma.go.kr). Apply for "단기예보조회"
# (VilageFcstInfoService_2.0/getVilageFcst) with this key.
KMA_AUTH_KEY=

# OpenAI API key (platform.openai.com). Server-side only.
OPENAI_API_KEY=
# Optional: the model for 일정 분석 and the like (default gpt-5-mini).
OPENAI_MODEL=

# Neon Object Storage (S3-compatible) for clothing photos. Names follow Neon's
# docs, so `neon env pull` fills the first four. The Neon project must be in a
# region that has Object Storage (this one is in aws-ap-southeast-1).
# Branch storage endpoint, e.g. https://br-xxxx.storage.c-4.ap-southeast-1.aws.neon.tech
AWS_ENDPOINT_URL_S3=
# e.g. ap-southeast-1
AWS_REGION=
# Neon storage credential: token_id (nak_live_...) and s3_secret_access_key
# (nsk_live_...). The secret is shown only once when the credential is created.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# A private bucket (e.g. `neon buckets create clothing-photos`).
CLOTHING_PHOTO_BUCKET=
